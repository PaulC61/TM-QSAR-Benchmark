#!/usr/bin/env bash
set -euo pipefail

TEMPLATE_FILE=".devcontainer/devcontainer.json.template"
OUTPUT_FILE=".devcontainer/devcontainer.json"

USER_ID=${USER_ID:-$(id -u)}
GROUP_ID=${GROUP_ID:-$(id -g)}
GROUP_NAME=${GROUP_NAME:-$(id -gn)}
USER_NAME=${USER_NAME:-$(whoami)}

# GPU detection: an H100/H200 dev box has `nvidia-smi` available; a laptop
# doesn't. Override explicitly with GPU=1 or GPU=0 if auto-detection guesses
# wrong (e.g. a GPU box whose driver isn't installed yet).
if [ -z "${GPU:-}" ]; then
    if command -v nvidia-smi >/dev/null 2>&1 && nvidia-smi >/dev/null 2>&1; then
        GPU=1
    else
        GPU=0
    fi
fi

if [ "$GPU" = "1" ]; then
    PIXI_IMAGE_TAG=${PIXI_IMAGE_TAG:-noble-cuda-12.8.1}
    # Pin to specific GPU(s) on a shared multi-GPU server (e.g. an 8x
    # H100/H200 box, indices 0-7): set GPU_DEVICE="3" or GPU_DEVICE="2,3"
    # before running this script. Defaults to all GPUs if unset.
    GPU_DEVICE=${GPU_DEVICE:-${CUDA_VISIBLE_DEVICES:-}}
    if [ -n "$GPU_DEVICE" ]; then
        GPU_RUN_ARGS="\"--gpus\", \"device=${GPU_DEVICE}\","
    else
        GPU_RUN_ARGS='"--gpus", "all",'
    fi
    # The gpu TM backend is just tmu's own CUDA clause bank (platform="CUDA"),
    # gated behind the opt-in `gpu` pixi feature/environment (needs `pycuda`,
    # which needs the CUDA toolchain this image tag provides) -- install it
    # too on a detected GPU box.
    PIXI_INSTALL_CMD="pixi install && pixi install -e gpu"
else
    PIXI_IMAGE_TAG=${PIXI_IMAGE_TAG:-0.41.4}
    GPU_RUN_ARGS=''
    PIXI_INSTALL_CMD="pixi install"
fi

export USER_ID GROUP_ID GROUP_NAME USER_NAME PIXI_IMAGE_TAG GPU_RUN_ARGS PIXI_INSTALL_CMD

echo "Using USER_ID: $USER_ID, GROUP_ID: $GROUP_ID, GROUP_NAME: $GROUP_NAME, USER_NAME: $USER_NAME"
echo "GPU=$GPU -> PIXI_IMAGE_TAG=$PIXI_IMAGE_TAG, PIXI_INSTALL_CMD=$PIXI_INSTALL_CMD"

# Plain literal substitution (not sed): PIXI_INSTALL_CMD contains "&&",
# which sed's replacement syntax treats as "insert the matched text"
# unless escaped, silently corrupting the output. python3's str.replace is
# always literal, so it's the safer tool here.
python3 - "$TEMPLATE_FILE" "$OUTPUT_FILE" << 'PYEOF'
import os
import sys

template_file, output_file = sys.argv[1], sys.argv[2]
content = open(template_file).read()
for var in ("USER_ID", "GROUP_ID", "GROUP_NAME", "USER_NAME", "PIXI_IMAGE_TAG", "GPU_RUN_ARGS", "PIXI_INSTALL_CMD"):
    content = content.replace(f"${var}", os.environ[var])
open(output_file, "w").write(content)
PYEOF
